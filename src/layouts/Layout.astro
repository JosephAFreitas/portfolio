---
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
	<head>
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content="Joseph Freitas — Data Engineer, BI Developer, and Computer Science student focused on analytics, automation, and AI-driven data systems." />
		<meta name="theme-color" content="#09090b" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Joseph Freitas | Data Engineer & BI Developer</title>
	</head>
	<body class="bg-zinc-950 text-zinc-300 antialiased">
		<slot />
	</body>
</html>

<style is:global>
  html, body {
    font-family: 'Inter', sans-serif;
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
